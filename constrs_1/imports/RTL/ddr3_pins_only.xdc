# SSTL135 is a Vref-referenced standard, so the bank needs its internal Vref set
# or DRC BIVRU-1 fails at placement. Copied from the MIG's own XDC (line 298).
set_property INTERNAL_VREF  0.675 [get_iobanks 15]
