# ddr3_ck_p/ck_n are declared as two SEPARATE single-ended ports on Au2_SLI's
# entity; only the MIG turns them into a differential pair via OBUFDS. With no
# MIG here they are single-ended, so DIFF_SSTL135 fails DRC IOSTDTYPE-1. They
# are idle in this build, so the single-ended standard is the honest constraint.
# ddr3_pins_only.xdc -- PIN CONSTRAINTS ONLY for the DDR3 ports, extracted from
# the MIG's generated XDC.
#
# WHY THIS EXISTS. build_pt_hdmi.tcl does not instantiate cam_frame_ft, and the MIG
# lives inside it, so the MIG's XDC is never read -- but Au2_SLI's ENTITY still
# declares the ddr3_* ports. Unconstrained ports fail DRC (NSTD-1 / UCIO-1), and the
# documented workaround of downgrading those checks to warnings is NOT acceptable
# here: Vivado would then place those ports on arbitrary package pins, and on this
# board those pins are physically wired to the DDR3 device. That is a hardware risk,
# not a paperwork one.
#
# Constraining them to their REAL locations is both safe and honest: the pins land
# where the board expects, and with no MIG driving them they simply sit idle.
# Timing/termination constraints are deliberately NOT copied -- there is no MIG here
# for them to apply to.
set_property SLEW FAST [get_ports {ddr3_dq[0]}]
set_property IN_TERM UNTUNED_SPLIT_50 [get_ports {ddr3_dq[0]}]
set_property IOSTANDARD SSTL135 [get_ports {ddr3_dq[0]}]
set_property PACKAGE_PIN J22 [get_ports {ddr3_dq[0]}]
set_property SLEW FAST [get_ports {ddr3_dq[1]}]
set_property IN_TERM UNTUNED_SPLIT_50 [get_ports {ddr3_dq[1]}]
set_property IOSTANDARD SSTL135 [get_ports {ddr3_dq[1]}]
set_property PACKAGE_PIN M21 [get_ports {ddr3_dq[1]}]
