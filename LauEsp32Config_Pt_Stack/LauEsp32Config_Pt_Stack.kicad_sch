	(text "U1 ESP32-S3-MINI-1U-N8: 8 MB flash, no PSRAM,\nexternal antenna connector. S3-MINI-1 shares the S2-MINI-1\nland pattern (KiCad's S3 symbol uses the S2 footprint).\nGPIO3/45/46 are STRAPS, left floating on purpose.\nGPIO1/2/26/39-42 spare."
		(exclude_from_sim no)
		(at 345 20 0)
		(effects
			(font
				(size 1.6 1.6)
			)
			(justify left top)
		)
		(uuid "5723fa16-ecb3-5674-afd6-215271df7848")
	)
